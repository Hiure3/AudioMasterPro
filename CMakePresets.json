{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    { "name": "windows-release", "inherits": "windows-base", "displayName": "Windows Release" },
    { "name": "windows-debug",   "inherits": "windows-base", "displayName": "Windows Debug" }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "windows-debug",   "configurePreset": "windows-debug",   "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "long" } }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "long" } }
    },
    {
      "name": "windows-release-long",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "long" } }
    }
  ]
}
